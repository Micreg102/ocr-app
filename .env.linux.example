# Copy to .env.linux on owui01:
#   cp .env.linux.example .env.linux

# OCR language (EasyOCR): en, pl, de, fr, ...
OCR_LANG=en

OCR_DEFAULT_ENGINE=easyocr
OCR_ENABLED_ENGINES=easyocr

# PDF render DPI (higher = better quality, slower / more RAM)
PDF_RENDER_DPI=200

# Host port published on owui01 (translator uses Docker DNS: ocr-backend:8000)
OCR_HOST_PORT=8000

# Optional frontend when started with: --profile ui
OCR_FRONTEND_PORT=3000

# Memory limit for OCR container (CPU-only EasyOCR)
OCR_MEMORY_LIMIT=6G
