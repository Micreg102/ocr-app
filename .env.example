# Optional — docker compose loads this file automatically as .env
#   cp .env.example .env

OCR_LANG=en
OCR_DEFAULT_ENGINE=easyocr
OCR_ENABLED_ENGINES=easyocr
PDF_RENDER_DPI=200

# Host port (translator uses Docker DNS: http://ocr-backend:8000)
OCR_HOST_PORT=8000

# Frontend port when using: docker compose --profile ui up -d
OCR_FRONTEND_PORT=3000

OCR_MEMORY_LIMIT=6G
