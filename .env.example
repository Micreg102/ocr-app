# Optional — docker compose loads this file automatically as .env
#   cp .env.example .env

OCR_LANG=en
OCR_DEFAULT_ENGINE=tesseract
OCR_ENABLED_ENGINES=tesseract
PDF_RENDER_DPI=200

# Host port on owui01 (translator still uses Docker DNS: http://ocr-backend:8000)
OCR_HOST_PORT=8100

# Frontend port when using: docker compose --profile ui up -d
OCR_FRONTEND_PORT=3000
